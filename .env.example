# Copy this file to `.env` and adjust the values.
# NEVER commit a real `.env` file — see SECURITY.md.

# ─── Infrastructure (docker compose) ────────────────────────────
MYSQL_ROOT_PASSWORD=alliswell_root
MYSQL_DATABASE=alliswell
MYSQL_USER=alliswell
MYSQL_PASSWORD=alliswell_dev
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=3000
# Local S3-compatible store for attachments (dev/CI stand-in for Cloudflare R2):
MINIO_ROOT_USER=alliswell
MINIO_ROOT_PASSWORD=alliswell_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── API (apps/api) ─────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=alliswell
DATABASE_PASSWORD=alliswell_dev
DATABASE_NAME=alliswell
# MySQL 8.0+ and MariaDB 10.11+ are both supported. The schema's utf8mb4
# collation is auto-detected per server (utf8mb4_0900_ai_ci on MySQL,
# utf8mb4_unicode_ci on MariaDB, which has no *_0900_* collation). Set this only
# to force a specific one, e.g. utf8mb4_uca1400_ai_ci on MariaDB 10.10+.
# DATABASE_COLLATION=
REDIS_URL=redis://127.0.0.1:6379
# Namespaces this deployment's BullMQ keyspace. Change it if more than one
# AllisWell instance shares a Redis — otherwise they consume each other's jobs,
# and since each has its own MySQL the stolen job is silently dropped.
# REDIS_KEY_PREFIX=alliswell
CORS_ORIGIN=*
# Set this when a reverse proxy (Apache/Nginx/Caddy) fronts the API — otherwise
# every request reads as the proxy's own IP and the per-IP rate limits below
# become ONE shared bucket for the whole deployment. Use the proxy's address
# (127.0.0.1 for a same-box proxy), a hop count, or `true`. Leave unset when the
# API is directly reachable: trusting X-Forwarded-For then lets clients spoof.
# TRUST_PROXY=127.0.0.1
RATE_LIMIT_MAX=300
# Stricter per-IP limit on /api/v1/auth/* routes (requests per minute):
RATE_LIMIT_AUTH_MAX=10

# ─── Auth (Epic 03 — generate strong random values!) ────────────
# Two DIFFERENT secrets, ≥ 32 chars each: openssl rand -hex 32
# Production refuses to boot with these placeholders (or missing values).
JWT_ACCESS_SECRET=change-me-generate-a-random-secret
JWT_REFRESH_SECRET=change-me-generate-another-random-secret
# Optional token lifetimes (defaults shown):
# AUTH_ACCESS_TTL_SEC=900
# AUTH_REFRESH_TTL_DAYS=30

# ─── Google Calendar (Epic 08 — optional) ───────────────────────
# Create an OAuth client (Web application) in Google Cloud Console and add
# GOOGLE_REDIRECT_URI to its authorized redirect URIs. Without these the
# integration endpoints answer GOOGLE_NOT_CONFIGURED and the app runs fine.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
# OAuth tokens are encrypted at rest with AES-256-GCM (ADR-0006).
# 64 hex chars: openssl rand -hex 32 — required in production when Google is configured.
# CALENDAR_TOKEN_KEY=
#
# Where Google POSTs "something changed" notifications (ADR-0007). OPTIONAL:
# Google only pushes to a public https address with a certificate it trusts, so
# leave it unset on localhost/behind NAT — inbound sync then polls instead
# (every CALENDAR_SYNC_SWEEP_SEC) and works exactly the same, just less
# promptly. Your Google Cloud project may also need the domain verified.
# GOOGLE_WEBHOOK_URL=https://your-host.example/api/v1/integrations/google/webhook
# Requested push-channel lifetime. Google caps it and answers with the real
# expiration; we renew a day before THAT, whatever it says.
# CALENDAR_WATCH_TTL_SEC=604800
# How often channels are renewed, dirty accounts retried, and channel-less
# accounts polled.
# CALENDAR_SYNC_SWEEP_SEC=300

# ─── Attachments / file storage (Epic 14 — optional) ────────────
# S3-compatible object storage for file attachments. Primary target: Cloudflare
# R2 (endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto, an R2
# API token's Access Key ID / Secret). Works identically against MinIO (the
# docker-compose service below) or AWS S3/B2. Leave ALL of it unset and the
# feature is off: file endpoints answer STORAGE_NOT_CONFIGURED, the app shows
# honest empty states. Setting SOME but not all of endpoint/bucket/keys is a
# boot error. Full guide incl. the REQUIRED bucket CORS rule for the web app:
# docs/ATTACHMENTS.md.
# STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=alliswell
# STORAGE_S3_ACCESS_KEY_ID=alliswell
# STORAGE_S3_SECRET_ACCESS_KEY=alliswell_dev
# Path-style URLs (bucket in the path). R2 accepts both; MinIO requires true.
# STORAGE_S3_FORCE_PATH_STYLE=true
# Per-file size cap, enforced at upload completion:
# STORAGE_MAX_UPLOAD_MB=512
# Presigned URL lifetime (seconds, 60…604800 — R2 caps at 7 days):
# STORAGE_PRESIGN_TTL_SEC=3600
# How often abandoned (never-completed) uploads are reaped:
# STORAGE_SWEEP_SEC=3600

# ── Recurring tasks (OPH-205, ADR-0020) ──────────────────────────────────────
# How often the 12-month occurrence window rolls forward. Daily is plenty —
# nothing about a horizon that far out is urgent. Minimum 10.
# SERIES_SWEEP_SEC=86400

# ─── AI (Epic 20 — ADR-0019, docs/AI.md) ─────────────────────────────────────
# The embedded AI track is BYOK (users bring their own provider keys), so it is
# ENABLED by default and needs no credentials here. Set false to withdraw every
# AI surface — all /ai/* endpoints answer 404 and the app hides the feature.
# AI_ENABLED=true
#
# BYOK keys are encrypted at rest with AES-256-GCM (the ADR-0006 pattern, its
# own key). 64 hex chars: openssl rand -hex 32 — REQUIRED in production while
# AI_ENABLED=true (the default): generate one or set AI_ENABLED=false.
# AI_TOKEN_KEY=
#
# Optional instance-wide keys (auth_mode='instance_env'): members can use the
# instance's own provider account instead of bringing a key. Per-user daily
# token cap below applies to these.
# AI_ANTHROPIC_API_KEY=
# AI_OPENAI_API_KEY=
# AI_GEMINI_API_KEY=
# AI_OPENROUTER_API_KEY=
# An instance-wide Ollama needs its address (per-user Ollama connections carry
# their own base_url instead):
# AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Stream/limit tunables (defaults shown). Heartbeat must stay under any proxy
# idle timeout; the rate is a per-user token bucket shared by chat + extract.
# AI_HEARTBEAT_MS=15000
# AI_RATE_PER_MINUTE=10
# AI_RATE_BURST=10
# Daily token ceiling per user on instance_env connections (0 = off):
# AI_DAILY_TOKEN_CAP=200000

# ─── MCP connector (Epic 20 Track A — ADR-0022, docs/MCP.md) ─────────────────
# The remote MCP server lets users add AllisWell to their own Claude/ChatGPT.
# It is INDEPENDENT of AI_ENABLED (spends no model money, stores no keys).
# API_PUBLIC_URL is the OAuth issuer + resource identity — set it to your
# instance's public origin; in production it MUST be https. Without it (in
# production) the /mcp and /oauth/* routes answer 404, never a boot error.
# API_PUBLIC_URL=https://api.your-instance.example
# MCP_ENABLED=true
# Token lifetimes and the per-token rate limit (defaults shown):
# MCP_ACCESS_TTL_SEC=3600
# MCP_REFRESH_TTL_DAYS=30
# MCP_RATE_LIMIT_MAX=120
