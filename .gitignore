# --- Node ---
node_modules/
npm-debug.log*
coverage/
*.tsbuildinfo

# --- Environment / secrets ---
.env
.env.*
# Templates are documentation, not secrets — every other .env.* stays ignored.
!.env.example
!.env.selfhost.example

# --- macOS ---
.DS_Store

# --- IDE / local agent tooling ---
.idea/
.vscode/
*.iml
.claude/

# --- Logs ---
*.log

# --- Build artifacts ---
dist/
build/

# --- Android release signing (NEVER commit: losing control of these means
# someone else can ship an update as you) ---
apps/app/android/key.properties
**/*.jks
**/*.keystore

# --- Screenshot & deploy pipeline outputs ---
# `screenshots/` and `store/` ARE committed: the README, the landing page and the
# store listings all point at them, and a fresh clone should render correctly.
# These three are derived from them on every build and must not be.
apps/landing/public/shots/
apps/landing/public/og-cover.png
publish/

# ── Firebase: code is public, credentials are not (ADR-0025) ────────────────
# The repo carries every line of Firebase WIRING so a fork can plug in its own
# project; it carries none of the identifiers that point at ours. Each of these
# has a committed `.example` beside it showing the shape.
apps/app/android/app/google-services.json
apps/app/ios/Runner/GoogleService-Info.plist
apps/app/macos/Runner/GoogleService-Info.plist
apps/app/lib/firebase_options.dart
# Generated by the Podfile from the plist's REVERSED_CLIENT_ID (ADR-0026).
apps/app/ios/Flutter/Firebase.xcconfig
.firebaserc
firebase-debug.log
.firebase/
# Service-account keys, wherever they land. There is no legitimate reason for
# one of these to be in a working tree that gets committed.
**/*-service-account*.json
**/serviceAccountKey*.json

# Python bytecode from scripts/
__pycache__/
*.pyc
