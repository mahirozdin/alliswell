{
  "name": "alliswell",
  "version": "1.13.0",
  "private": true,
  "description": "AllisWell \u2014 source-available, self-hosted productivity hub: tasks, projects, notes, documents, calendar sync and reminders.",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "apps/landing"
  ],
  "scripts": {
    "dev": "npm run dev -w @alliswell/api",
    "start": "npm run start -w @alliswell/api",
    "landing:dev": "npm run dev -w @alliswell/landing",
    "landing:build": "npm run build -w @alliswell/landing",
    "seed:demo": "node scripts/seed-demo.mjs",
    "shots:web": "node scripts/screenshots/web.mjs",
    "shots:store": "node scripts/screenshots/store.mjs",
    "shots:ee": "node scripts/screenshots/ee-collect.mjs",
    "lint": "npm run lint -w @alliswell/api",
    "format": "npm run format -w @alliswell/api",
    "format:check": "npm run format:check -w @alliswell/api",
    "test": "npm run test -w @alliswell/api",
    "test:integration": "npm run test:integration -w @alliswell/api",
    "db:migrate": "npm run db:migrate -w @alliswell/api",
    "db:rollback": "npm run db:rollback -w @alliswell/api",
    "check:no-ts": "bash scripts/check-no-ts.sh",
    "check:no-ee": "bash scripts/check-no-ee.sh",
    "check:i18n": "node scripts/i18n/check.mjs",
    "check:docs": "node scripts/docs/check.mjs",
    "check:pages": "node apps/landing/scripts/check-pages.mjs",
    "check:copy": "node apps/landing/scripts/check-copy.mjs",
    "check:fab": "node scripts/design/check-extended-fab.mjs",
    "check:opacity": "node scripts/design/check-opacity.mjs",
    "check:push-payload": "node scripts/push/payload.mjs",
    "check:notify-matrix": "node scripts/notifications/matrix.mjs",
    "check:openapi": "node scripts/api/openapi.mjs --check",
    "openapi": "node scripts/api/openapi.mjs",
    "api:docs": "node scripts/api/openapi.mjs && node scripts/api/reference.mjs && node scripts/api/postman.mjs",
    "check:apidocs": "node scripts/api/reference.mjs --check",
    "check:postman": "node scripts/api/postman.mjs --check",
    "gen:sync-fields": "node scripts/sync/fields.mjs",
    "check:sync-fields": "node scripts/sync/fields.mjs --check",
    "check:search-reachable": "node scripts/search/check-reachable.mjs",
    "next": "node scripts/tasks/next.mjs",
    "verify:task": "node scripts/verify/verify.mjs task",
    "verify:batch": "node scripts/verify/verify.mjs batch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahirozdin/alliswell"
  }
}
