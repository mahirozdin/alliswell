# AllisWell — self-hosting configuration (docker-compose.selfhost.yml).
# Copy to `.env` NEXT TO the compose file and fill in. Never commit the result.

# ── Which release to run ─────────────────────────────────────────────────────
# A version tag pins the deployment (recommended); `latest` follows releases.
ALLISWELL_VERSION=latest

# ── Your addresses ───────────────────────────────────────────────────────────
# Where the browser reaches the API. Baked into nothing — read at container
# start, so changing it is a restart, not a rebuild.
ALLISWELL_API_URL=https://api.alliswell.example
# Where the web app is served from. The API rejects browser calls from any
# other origin (CORS), so these two must match your real domains.
CORS_ORIGIN=https://alliswell.example

# ── Secrets (generate real ones!) ────────────────────────────────────────────
# Two DIFFERENT values: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Database password (also used to create the MySQL user on first start).
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
# DATABASE_USER=alliswell
# DATABASE_NAME=alliswell

# ── Ports (both bind to loopback: put Caddy/Nginx/Traefik in front for TLS) ──
# API_BIND=127.0.0.1
# API_PORT=3000
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

# ── Optional: Google Calendar two-way sync ───────────────────────────────────
# Create a Web OAuth client, add the redirect URI below to it, and set a
# CALENDAR_TOKEN_KEY (64 hex chars: openssl rand -hex 32) to encrypt tokens.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api.alliswell.example/api/v1/integrations/google/callback
# CALENDAR_TOKEN_KEY=
# Instant push instead of 5-minute polling (needs a domain Google has verified):
# GOOGLE_WEBHOOK_URL=https://api.alliswell.example/api/v1/integrations/google/webhook

# ── Optional: file attachments on Cloudflare R2 / any S3 ─────────────────────
# Keep the bucket PRIVATE — the API hands out short-lived presigned URLs, so
# nothing is ever publicly readable. Full guide: docs/ATTACHMENTS.md
# STORAGE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=alliswell
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Per-file cap in MB (abuse guard; rejected before a single byte is uploaded):
# STORAGE_MAX_UPLOAD_MB=10
# How long a download/upload link stays valid, in seconds:
# STORAGE_PRESIGN_TTL_SEC=900
