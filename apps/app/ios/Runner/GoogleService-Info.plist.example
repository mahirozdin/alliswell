<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — copy to GoogleService-Info.plist (and to macos/Runner/ for the macOS
  build) and fill in from YOUR OWN Firebase project. The real files are gitignored
  (ADR-0025): AllisWell ships every line of Firebase wiring and none of the
  identifiers that point at the maintainer's project.

  Get yours: Firebase console > Project settings > Your apps > iOS, or run
  `firebase apps:sdkconfig IOS` with your app id, project and an output path of
  apps/app/ios/Runner/GoogleService-Info.plist. The copy-pastable command lives
  in docs/FIREBASE.md, not here: an XML comment may not contain a double hyphen,
  and this file spent a while being invalid XML because a CLI flag does. That is
  not cosmetic — the Podfile PARSES this file when the real one is absent, so a
  fresh clone could not run `pod install` at all.

  WITHOUT this file the app still builds and runs — initialisation is guarded and
  Firebase reports itself unconfigured. See docs/FIREBASE.md.

  These values are not secrets in the password sense: they ship inside every
  installed app and Apple/Google treat them as public identifiers. They are kept
  out of the repository because they POINT AT a billed project, not because they
  unlock it. What protects the project is Security Rules, App Check and the
  bundle IDs registered against it.

  BUNDLE_ID must match the target you build. AllisWell uses com.alliswell.alliswell
  on iOS and macOS alike.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>YOUR_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.alliswell.alliswell</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project-id</string>
	<key>STORAGE_BUCKET</key>
	<string>your-firebase-project-id.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
