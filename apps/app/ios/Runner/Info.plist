<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AllisWell</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AllisWell</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>space.alliswell.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>alliswell</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
		<!-- Round 17 #1 (OPH-242): the share extension's ONLY way back into the
		     app. AllisWellShare subclasses RSIShareViewController, which writes
		     the payload to the App Group and then opens
		     `ShareMedia-<host bundle id>:share` (RSIShareViewController.swift,
		     `kSchemePrefix` = "ShareMedia"). Without this entry the scheme is
		     unregistered, iOS drops the open silently, and "Share to AllisWell"
		     does nothing at all — no launch, no crash, no report. That is
		     exactly what round 17 #1 described.
		     Guarded by test/native_config_test.dart. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>space.alliswell.sharemedia</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ShareMedia-$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAlarmKitUsageDescription</key>
	<string>AllisWell uses alarms so your urgent tasks ring on time — even when your phone is on silent or in Focus.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>AllisWell shows your calendar next to your tasks, and adds the tasks you choose as calendar events. It never changes events it did not create.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>AllisWell shows your calendar next to your tasks, and adds the tasks you choose as calendar events. It never changes events it did not create.</string>
	<!-- OPH-244: the ONLY new declaration the three-way attach menu costs.
	     "Photos" goes through PHPickerViewController, which runs out of process
	     and needs no permission and no dialog — NSPhotoLibraryUsageDescription
	     below is legacy and stays only because removing a shipped string is a
	     store-review conversation of its own. The camera genuinely needs this
	     one. -->
	<key>NSCameraUsageDescription</key>
	<string>AllisWell uses the camera so you can take a photo and attach it to a task or a note. Photos are only taken when you ask.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AllisWell needs access to your photos so you can attach them to tasks and notes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AllisWell uses the microphone so you can speak tasks and notes into it. Nothing is recorded until you hold to talk.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AllisWell turns your speech into text on your device so you can add tasks by voice. Only the text — never the audio — is sent when you use AI.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Round 16 follow-up: AllisWell opens markdown files, so it shows up in
	     "Open with" / the Files app / a mail attachment's share sheet.
	     `net.daringfireball.markdown` is the UTI Apple ships; the Editor role
	     with LSSupportsOpeningDocumentsInPlace lets the OS hand us the real
	     file instead of a copy in Inbox/. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UISupportsDocumentBrowser</key>
	<false/>
</dict>
</plist>
