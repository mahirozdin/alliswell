require 'fileutils'
# Firebase 12.x'in taban gereksinimi iOS 15.0 (ADR-0025). Daha düşüğünde
# CocoaPods 'required a higher minimum deployment target' ile durur.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Firebase config: keep a fresh clone buildable (ADR-0025).
#
# GoogleService-Info.plist is gitignored, and Xcode's Copy Bundle Resources
# treats it as a REQUIRED build input — so without this, cloning the repo and
# running `flutter build ios` fails with "Build input file cannot be found"
# before a single line of Dart is compiled. Android has no equivalent problem
# because its Gradle plugins are applied conditionally; iOS cannot express that.
#
# So: if the real file is absent, materialise the committed .example in its
# place. The app then starts, Firebase.initializeApp() fails on the placeholder
# ids, AwFirebase reports itself unconfigured, and everything else works —
# which is exactly the degradation the ADR describes.
#
# `pod install` runs as part of every `flutter build ios`, so this self-heals.
plist = File.join(__dir__, 'Runner', 'GoogleService-Info.plist')
unless File.exist?(plist)
  example = "#{plist}.example"
  if File.exist?(example)
    FileUtils.cp(example, plist)
    Pod::UI.warn 'AllisWell: no GoogleService-Info.plist — using the placeholder ' \
                 'from GoogleService-Info.plist.example. The build works; Firebase ' \
                 'stays off. See docs/FIREBASE.md to point it at your own project.'
  end
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # OPH-225 (ADR-0023): the share extension needs RSIShareViewController from
  # receive_sharing_intent. It must NOT compile that pod itself — the pod also
  # carries the Flutter plugin registrar, whose `addApplicationDelegate` is
  # unavailable in an app extension and fails the build. `inherit! :search_paths`
  # is the plugin author's own recipe: the pod is built once for Runner (where
  # that API is legal) and the extension links the framework the app embeds.
  target 'AllisWellShare' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
