{
  "_comment": "ADR-0020 §6 — the recurrence engine exists twice (apps/api/src/lib/recurrence.js produces occurrences, apps/app/lib/src/core/recurrence.dart previews them) and BOTH suites assert this file. Edit one implementation alone and a suite goes red. Same contract as fold_parity.json (ADR-0013). Dates are wall dates in the series timezone; the engine never sees a clock.",
  "cases": [
    {
      "name": "A — the 31st clamps backwards in short months (never skips)",
      "rule": { "freq": "monthly", "interval": 1, "byMonthDay": [31] },
      "anchor": "2026-01-31",
      "from": "2026-01-01",
      "to": "2026-06-30",
      "expected": [
        "2026-01-31",
        "2026-02-28",
        "2026-03-31",
        "2026-04-30",
        "2026-05-31",
        "2026-06-30"
      ]
    },
    {
      "name": "A — the same rule finds February 29th in a leap year",
      "rule": { "freq": "monthly", "interval": 1, "byMonthDay": [31] },
      "anchor": "2028-01-31",
      "from": "2028-01-01",
      "to": "2028-03-31",
      "expected": ["2028-01-31", "2028-02-29", "2028-03-31"]
    },
    {
      "name": "A — 'the last day of the month' is a first-class value, not a workaround",
      "rule": { "freq": "monthly", "interval": 1, "byMonthDay": [-1] },
      "anchor": "2026-01-31",
      "from": "2026-01-01",
      "to": "2026-03-31",
      "expected": ["2026-01-31", "2026-02-28", "2026-03-31"]
    },
    {
      "name": "B — the 2nd Tuesday of every month",
      "rule": { "freq": "monthly", "interval": 1, "byWeekday": [{ "day": "TU", "ordinal": 2 }] },
      "anchor": "2026-01-01",
      "from": "2026-01-01",
      "to": "2026-04-30",
      "expected": ["2026-01-13", "2026-02-10", "2026-03-10", "2026-04-14"]
    },
    {
      "name": "B — the last Friday of every month",
      "rule": { "freq": "monthly", "interval": 1, "byWeekday": [{ "day": "FR", "ordinal": -1 }] },
      "anchor": "2026-01-01",
      "from": "2026-01-01",
      "to": "2026-03-31",
      "expected": ["2026-01-30", "2026-02-27", "2026-03-27"]
    },
    {
      "name": "B — a 5th Monday is not clamped: months without one simply have no occurrence",
      "rule": { "freq": "monthly", "interval": 1, "byWeekday": [{ "day": "MO", "ordinal": 5 }] },
      "anchor": "2026-01-01",
      "from": "2026-01-01",
      "to": "2026-06-30",
      "expected": ["2026-03-30", "2026-06-29"]
    },
    {
      "name": "C — the first Monday after the 22nd (weekday limits a 7-day window)",
      "rule": {
        "freq": "monthly",
        "interval": 1,
        "byWeekday": [{ "day": "MO", "ordinal": null }],
        "byMonthDay": [23, 24, 25, 26, 27, 28, 29]
      },
      "anchor": "2026-01-01",
      "from": "2026-01-01",
      "to": "2026-04-30",
      "expected": ["2026-01-26", "2026-02-23", "2026-03-23", "2026-04-27"]
    },
    {
      "name": "C — the named limitation: a short February whose 22nd is itself a Monday is skipped",
      "rule": {
        "freq": "monthly",
        "interval": 1,
        "byWeekday": [{ "day": "MO", "ordinal": null }],
        "byMonthDay": [23, 24, 25, 26, 27, 28, 29]
      },
      "anchor": "2027-01-01",
      "from": "2027-01-01",
      "to": "2027-03-31",
      "expected": ["2027-01-25", "2027-03-29"]
    },
    {
      "name": "every other week on Monday and Wednesday",
      "rule": {
        "freq": "weekly",
        "interval": 2,
        "byWeekday": [
          { "day": "MO", "ordinal": null },
          { "day": "WE", "ordinal": null }
        ]
      },
      "anchor": "2026-01-05",
      "from": "2026-01-01",
      "to": "2026-02-01",
      "expected": ["2026-01-05", "2026-01-07", "2026-01-19", "2026-01-21"]
    },
    {
      "name": "weekdays preset — the anchor's own week is not back-filled",
      "rule": {
        "freq": "weekly",
        "interval": 1,
        "byWeekday": [
          { "day": "MO", "ordinal": null },
          { "day": "TU", "ordinal": null },
          { "day": "WE", "ordinal": null },
          { "day": "TH", "ordinal": null },
          { "day": "FR", "ordinal": null }
        ]
      },
      "anchor": "2026-01-01",
      "from": "2026-01-01",
      "to": "2026-01-12",
      "expected": [
        "2026-01-01",
        "2026-01-02",
        "2026-01-05",
        "2026-01-06",
        "2026-01-07",
        "2026-01-08",
        "2026-01-09",
        "2026-01-12"
      ]
    },
    {
      "name": "every 3 days across a month boundary",
      "rule": { "freq": "daily", "interval": 3 },
      "anchor": "2026-01-28",
      "from": "2026-01-01",
      "to": "2026-02-10",
      "expected": ["2026-01-28", "2026-01-31", "2026-02-03", "2026-02-06", "2026-02-09"]
    },
    {
      "name": "end.count is measured from the anchor, not from the window",
      "rule": { "freq": "daily", "interval": 1, "end": { "type": "count", "count": 4 } },
      "anchor": "2026-01-01",
      "from": "2026-01-03",
      "to": "2026-12-31",
      "expected": ["2026-01-03", "2026-01-04"]
    },
    {
      "name": "end.until is inclusive",
      "rule": {
        "freq": "weekly",
        "interval": 1,
        "byWeekday": [{ "day": "MO", "ordinal": null }],
        "end": { "type": "until", "until": "2026-01-19" }
      },
      "anchor": "2026-01-05",
      "from": "2026-01-01",
      "to": "2026-12-31",
      "expected": ["2026-01-05", "2026-01-12", "2026-01-19"]
    },
    {
      "name": "yearly on February 29th clamps to the 28th in common years — a leap-day task does not disappear for four years",
      "rule": { "freq": "yearly", "interval": 1, "byMonthDay": [29], "byMonth": [2] },
      "anchor": "2028-02-29",
      "from": "2028-01-01",
      "to": "2032-12-31",
      "expected": [
        "2028-02-29",
        "2029-02-28",
        "2030-02-28",
        "2031-02-28",
        "2032-02-29"
      ]
    },
    {
      "name": "yearly with no day selector repeats the anchor's own date",
      "rule": { "freq": "yearly", "interval": 1 },
      "anchor": "2026-07-14",
      "from": "2026-01-01",
      "to": "2029-12-31",
      "expected": ["2026-07-14", "2027-07-14", "2028-07-14", "2029-07-14"]
    },
    {
      "name": "a rolling window returns only its own slice",
      "rule": { "freq": "monthly", "interval": 1, "byMonthDay": [15] },
      "anchor": "2026-01-15",
      "from": "2026-04-01",
      "to": "2026-06-30",
      "expected": ["2026-04-15", "2026-05-15", "2026-06-15"]
    }
  ]
}
