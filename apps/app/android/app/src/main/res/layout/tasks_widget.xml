<?xml version="1.0" encoding="utf-8"?>
<!-- AllisWell home-screen widget (OPH-133): date header + scrollable bucketed
     task list. Populated by TasksWidgetProvider / TasksWidgetService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/tasks_widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/aw_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/aw_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/aw_widget_text"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:text="•" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aw_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/aw_widget_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aw_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/aw_widget_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- OPH-253 (round 17 #4): the header's right column is two stacked
             lines — the system clock on top, today's open count under it, both
             hard against the trailing edge (gravity="end"; two lines of
             different widths left-aligned read as a typo).

             TextClock is a @RemoteView: inside the launcher's host view it
             registers its own time receivers and ticks for free. That is the
             whole reason Android needs none of the minute-granular timeline
             machinery iOS does, and why the clock costs no refresh here at all
             (DESIGN §31 C4). The formats below are only defaults for the widget
             picker's preview — TasksWidgetProvider overwrites both with the
             pattern the app chose (C2). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextClock
                android:id="@+id/aw_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/aw_widget_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm" />

            <!-- OPH-187 #4B: today's open count (overdue + due today). Text and
                 number both come pre-localized from the app snapshot; GONE at
                 zero — and when it goes, aw_header's center_vertical gravity
                 puts the clock on the vertical centre by itself (C5). -->
            <TextView
                android:id="@+id/aw_open_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/aw_widget_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/aw_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp" />

    <TextView
        android:id="@+id/aw_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/aw_widget_secondary"
        android:textSize="14sp"
        tools:ignore="HardcodedText"
        android:text="All caught up" />
</LinearLayout>
