# alliswell.space — one docroot, two apps.
#
#   /       → the marketing site (Vue 3, this bundle)
#   /app    → the Flutter web app, built with --base-href /app/
#
# Both are SPAs, so both need "serve index.html for anything that is not a real
# file". The order matters: /app must be handled BEFORE the site's own fallback,
# or the marketing page swallows every deep link into the app.
#
# Deployed by .github/workflows/deploy.yml — edit it here, not on the server.

<IfModule mod_dir.c>
  # mod_dir's trailing-slash redirect fires for a directory request BEFORE the
  # in-place rule below ever runs — the RewriteRule alone never took effect.
  # EE-151 added the rule on 2026-09-06 and /enterprise kept answering 301 on
  # the live box; reproduced on 2026-09-11 in a stock httpd:2.4 with this very
  # file (mod_rewrite on, AllowOverride All): /enterprise, /tr, /privacy all
  # 301, and with DirectorySlash Off all three serve their page in place.
  #
  # Safe to turn off here: every directory a visitor can name carries an
  # index.html and is rewritten to it below, and -Indexes makes sure a
  # directory that does not (assets/, shots/) answers 403 rather than a
  # listing. Override: Indexes and Options, both under the AllowOverride All
  # the <If> block further down already proves this docroot has.
  DirectorySlash Off
</IfModule>
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # The Flutter app keeps its slash. It is built with --base-href /app/ and has
  # always been reached at /app/; serving its index in place at /app would hand
  # the router a path the base href does not cover. This is the one directory
  # that is redirected on purpose, and it must come before the in-place rule.
  RewriteRule ^app$ /app/ [R=301,L]

  # A generated directory page is served IN PLACE rather than redirected to its
  # trailing slash (EE-151, made effective in EE-164 by DirectorySlash Off).
  #
  # Without this the canonical each of these pages declares is a URL that
  # redirects, which is a canonical a crawler distrusts. Measured on
  # 2026-09-06: /enterprise, /privacy, /support and /docs/api all answered 301.
  #
  # Real files still win: /logo.svg/index.html is not a file, so the condition
  # is false and the rule skips them. The pattern needs at least one character,
  # so "/" itself falls through to the -d rule as before.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Real files and directories always win (assets, .well-known, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /app deep links → the Flutter bundle's index.
  RewriteRule ^app(/.*)?$ /app/index.html [L]

  # Everything else → the marketing site.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The MARKETING bundle is content-hashed by Vite (`index-A1b2C3d4.js`), so its
  # assets really are immutable: a new build writes a new filename.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|flutter_service_worker\.js|alliswell-config\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # The FLUTTER bundle is not, and the rule above used to swallow it whole.
  #
  # `main.dart.js`, `flutter_bootstrap.js`, `flutter.js` and everything under
  # `assets/` keep the SAME NAME from build to build and change content on
  # every release — so `immutable, max-age=31536000` told every returning
  # browser to run the app it already had, for a year, without ever asking.
  #
  # Measured 2026-08-17, and it is exactly what a user sees: the origin served
  # v1.5.0 (`/app/version.json` said so, and the deployed `tr.json` carried the
  # new strings), while the browser kept executing the `main.dart.js` it had
  # cached — so shipped features simply were not there. index.html was fresh,
  # the service worker was fresh, and neither could help: the app's own code
  # was never re-fetched.
  #
  # `<If>` is merged after `<FilesMatch>`, so this wins for everything under
  # /app/ regardless of extension. Revalidation is cheap — ETags are on, and an
  # unchanged file answers 304.
  <If "%{REQUEST_URI} =~ m#^/app/#">
    Header set Cache-Control "no-cache, must-revalidate"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
