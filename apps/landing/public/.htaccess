# alliswell.space — one docroot, two apps.
#
#   /       → the marketing site (Vue 3, this bundle)
#   /app    → the Flutter web app, built with --base-href /app/
#
# Both are SPAs, so both need "serve index.html for anything that is not a real
# file". The order matters: /app must be handled BEFORE the site's own fallback,
# or the marketing page swallows every deep link into the app.
#
# Deployed by .github/workflows/deploy.yml — edit it here, not on the server.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files and directories always win (assets, .well-known, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /app deep links → the Flutter bundle's index.
  RewriteRule ^app(/.*)?$ /app/index.html [L]

  # Everything else → the marketing site.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The MARKETING bundle is content-hashed by Vite (`index-A1b2C3d4.js`), so its
  # assets really are immutable: a new build writes a new filename.
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|flutter_service_worker\.js|alliswell-config\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # The FLUTTER bundle is not, and the rule above used to swallow it whole.
  #
  # `main.dart.js`, `flutter_bootstrap.js`, `flutter.js` and everything under
  # `assets/` keep the SAME NAME from build to build and change content on
  # every release — so `immutable, max-age=31536000` told every returning
  # browser to run the app it already had, for a year, without ever asking.
  #
  # Measured 2026-08-17, and it is exactly what a user sees: the origin served
  # v1.5.0 (`/app/version.json` said so, and the deployed `tr.json` carried the
  # new strings), while the browser kept executing the `main.dart.js` it had
  # cached — so shipped features simply were not there. index.html was fresh,
  # the service worker was fresh, and neither could help: the app's own code
  # was never re-fetched.
  #
  # `<If>` is merged after `<FilesMatch>`, so this wins for everything under
  # /app/ regardless of extension. Revalidation is cheap — ETags are on, and an
  # unchanged file answers 304.
  <If "%{REQUEST_URI} =~ m#^/app/#">
    Header set Cache-Control "no-cache, must-revalidate"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
